# ─────────────────────────────────────────────────────────────
#  siaf-felicitaciones — variables de entorno
#  Local: copia este archivo a  server/.env  y ajusta valores.
#  Producción: el contenido real vive en  /var/www/.env.siaf-felicitaciones
#  y el workflow lo copia a  server/.env  en cada deploy.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5007
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5007
TZ=America/Mexico_City

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=felicitaciones_admin
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=felicitaciones_db

# ── Auth ──
JWT_SECRET=GENERA_UN_STRING_LARGO_Y_ALEATORIO
JWT_EXPIRE=7d
SEED_PASSWORD=123456

# ── Almacenamiento (sesión de WhatsApp) ──
# En local puedes omitirlo: usa  server/storage  por defecto.
STORAGE_PATH=/var/www/siaf-felicitaciones/server/storage

# ── Programación del envío ──
# Valor INICIAL (cron de 5 campos, hora de TZ). Después se ajusta desde el panel
# (pestaña Envíos → "Programación del envío automático") y queda guardado en la BD.
CRON_CUMPLEANOS=0 8 * * *
ENVIAR_WHATSAPP=true
ENVIAR_EMAIL=false
# Código de país que se antepone a los teléfonos de 10 dígitos (México = 52).
WHATSAPP_PAIS_DEFAULT=52
# DRY_RUN=true  ->  no envía nada, solo registra en envios_log qué haría.
DRY_RUN=false

# ── Tarjeta personalizada ──
# Se estampa el nombre del profesor sobre la plantilla ACTIVA y esa imagen es la
# que se envía. Las plantillas y la posición del nombre se gestionan desde el
# panel (pestaña "Plantillas"); estas variables solo definen los valores por
# defecto con los que se registra la plantilla incluida al correr `npm run seed`.
ENVIAR_IMAGEN=true
FELICITACION_NOMBRE_X=0.5
FELICITACION_NOMBRE_Y=0.7
FELICITACION_NOMBRE_SIZE=0.04
FELICITACION_NOMBRE_COLOR=#1b2a6b
# FELICITACION_IMAGEN=/ruta/a/otra-plantilla.jpg   (plantilla incluida por defecto)

# ── SMTP (Gmail con App Password de 16 caracteres) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cuenta@gmail.com
SMTP_PASS=APP_PASSWORD_DE_16_CARACTERES
SMTP_FROM="Felicitaciones FCCA <cuenta@gmail.com>"
